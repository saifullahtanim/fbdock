# ==========================================
# FBDock Contact Form Email Configuration
# ==========================================
# To receive real emails in your inbox when visitors send messages through contact.html,
# configure your SMTP or Gmail App Password below:

# Gmail Configuration (Recommended & Free):
# 1. Go to your Google Account -> Security -> 2-Step Verification (turn on if not already)
# 2. Go to "App passwords" (https://myaccount.google.com/apppasswords)
# 3. Create an App Password (name it "FBDock") and copy the 16-character code
# 4. Fill in below and rename this file to .env

GMAIL_USER=saifullatanim.cse@gmail.com
GMAIL_APP_PASS=your_16_char_app_password_here

# The email where you want to receive the messages:
CONTACT_RECEIVER_EMAIL=saifullatanim.cse@gmail.com

# Or Custom SMTP Server (Optional):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
